# Copy this file to .env on the Linux server and replace every production value.
APP_ENV=production
PORT=8080
POSTGRES_DB=aiswitch
POSTGRES_USER=aiswitch
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-unique-random-string-at-least-32-characters-long
CARD_CODE_PEPPER=replace-with-a-different-random-string-at-least-32-characters-long
CORS_ALLOWED_ORIGINS=tauri://localhost,https://tauri.localhost
